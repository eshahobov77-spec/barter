# ------------------------------------------------------------------ Baza
# Docker compose ishlatilganda bu qiymat compose ichida avtomatik beriladi.
# Lokal ishga tushirish uchun o'zingizning Postgres manzilingizni yozing:
DATABASE_URL=postgresql://barter:barter@localhost:5432/barter?schema=public

# docker-compose uchun (db konteyneri shu qiymatlar bilan yaratiladi)
POSTGRES_DB=barter
POSTGRES_USER=barter
POSTGRES_PASSWORD=kuchli-parolni-shu-yerga-yozing

# ------------------------------------------------------------------ Ilova
# Sayt qaysi portda ochilsin (host tomonda)
APP_PORT=3000

# Vaqt mintaqasi — sanalar va oylik hisobot shu bo'yicha hisoblanadi
TZ=Asia/Tashkent

# HTTPS ortida ishlayotgan bo'lsa true qiling (cookie faqat https orqali yuboriladi)
SECURE_COOKIES=false

# Sessiya necha kun amal qiladi
SESSION_DAYS=14

# ------------------------------------------------------------------ Admin
# Birinchi ishga tushishda shu foydalanuvchi yaratiladi.
# Parol "admin" bo'lsa, birinchi kirishda uni almashtirish so'raladi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ------------------------------------------------------------------ Telegram bot
# true bo'lsa, rejali hisobotlar va /bugun, /hafta kabi buyruqlar shu server ichida ishlaydi.
# Token va Chat ID lar saytdagi «Bot sozlamalari» sahifasidan kiritiladi.
ENABLE_BOT=true

# ------------------------------------------------------------------ IP-telefoniya
# false bo'lsa, qo'ng'iroqlarni qayta ishlovchi fon jarayoni umuman ishga tushmaydi.
# Kalitlar, token va provayder sozlamalari saytdagi «IP-telefoniya» sahifasidan kiritiladi.
ENABLE_TELEPHONY=true
# Audio fayllar papkasi (Docker'da volume ulangan)
CALLS_DIR=/app/data/calls
# Provayder audio havolasi ichki tarmoqda bo'lsa (masalan, o'z Asterisk serveringiz) — true
ALLOW_PRIVATE_AUDIO=false
